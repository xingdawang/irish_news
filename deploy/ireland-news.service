[Unit]
Description=Ireland News mobile website
After=network.target

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/ireland-news
Environment=PYTHONUNBUFFERED=1
ExecStart=/home/ubuntu/ireland-news/.venv/bin/uvicorn app:app --host 127.0.0.1 --port 8200
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
